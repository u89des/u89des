# Public browser configuration. Safe to expose when RLS is enabled.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_U89_WORKSPACE_SLUG=u89

# Vercel server configuration. Never prefix these values with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_KEY
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE
NOTIFICATION_WEBHOOK_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_VALUE
PUBLIC_APP_URL=https://u89des.com

# Email notifications through Resend.
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=U89 <notifications@u89des.com>

# WhatsApp Cloud API. The template must be approved by Meta.
WHATSAPP_PHONE_NUMBER_ID=REPLACE_ME
WHATSAPP_ACCESS_TOKEN=REPLACE_ME
WHATSAPP_TEMPLATE_NAME=u89_project_update
WHATSAPP_TEMPLATE_LANGUAGE=ar
WHATSAPP_GRAPH_VERSION=vXX.X
