{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/work-preview", "destination": "/index.html" },
    { "source": "/work-preview/:path*", "destination": "/index.html" },
    { "source": "/studio", "destination": "/index.html" },
    { "source": "/studio/:path*", "destination": "/index.html" },
    { "source": "/workspace/:path*", "destination": "/index.html" },
    { "source": "/portal/:path*", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/notifications/dispatch", "schedule": "0 3 * * *" }
  ]
}
